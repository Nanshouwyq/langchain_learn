PYTHONDONTWRITEBYTECODE=1
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6
# kimi-k2.6：disabled 关闭深度思考（Agent 首轮更快）；enabled 打开
MOONSHOT_THINKING=disabled
# 延迟优化（可选）
# AGENT_MAX_TOKENS=512
# RAG_MAX_TOKENS=1024
# CONTEXT_MAX_CHARS=2200
# ENABLE_RAG_SHORTCUT=true

SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=BAAI/bge-large-zh-v1.5

# LangSmith 链路追踪（https://smith.langchain.com 创建 API Key）
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=langchain-learn
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 数据库连接地址（本机 PostgreSQL）
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your-password@127.0.0.1:5432/lmops?client_encoding=utf8
# 连接池参数
POOL_SIZE=30
POOL_RECYCLE=3600
# SQL打印调试开关
SQLALCHEMY_ECHO=true
